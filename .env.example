# API origin for the live Portfolio/Gallery backend.
# Uploads returned by the API (e.g. /uploads/fursona/x.jpg) are resolved against this.
VITE_API_BASE_URL=https://ecomdesignshub.runasp.net
# VITE_API_BASE_URL=https://localhost:7230

# Set to "true" to render bundled sample data (shaped exactly like the API)
# through the same data hooks — handy for previewing the UI offline before the
# backend is reachable. Leave unset/false to use the live API above.
VITE_DEMO_MODE=false

# Optional performance fast-path: if set, the WhatsApp cart-checkout button
# can build its wa.me link immediately instead of waiting on a network
# round-trip to the API just to learn the business number. Server-side
# inquiry logging still happens in the background either way. Leave unset
# to keep the original behavior (always resolve the number from the API).
# VITE_WHATSAPP_NUMBER=16094594343
